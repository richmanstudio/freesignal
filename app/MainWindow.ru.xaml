<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeSignal" Width="1220" Height="800" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="#080808" Foreground="#F2F2F2" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#B6FF00"/>
    <SolidColorBrush x:Key="Background" Color="#080808"/>
    <SolidColorBrush x:Key="Panel" Color="#101010"/>
    <SolidColorBrush x:Key="Panel2" Color="#151515"/>
    <SolidColorBrush x:Key="Border" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="Muted" Color="#8D8D8D"/>
    <SolidColorBrush x:Key="Danger" Color="#FF5C5C"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F2F2F2"/>
    </Style>
    <Style TargetType="Button" x:Key="FlatButton">
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="7" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource FlatButton}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="#080808"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,12"/>
    </Style>
    <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource FlatButton}">
      <Setter Property="Background" Value="#191919"/>
      <Setter Property="BorderBrush" Value="#333333"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,11"/>
    </Style>
    <Style TargetType="Button" x:Key="NavButton" BasedOn="{StaticResource FlatButton}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Padding" Value="14,11"/>
      <Style.Triggers>
        <Trigger Property="Tag" Value="active">
          <Setter Property="Background" Value="#1D260E"/>
          <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0D0D0D"/>
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="BorderBrush" Value="#303030"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#151515"/>
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="BorderBrush" Value="#303030"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="MinWidth" Value="190"/>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#0D0D0D" BorderBrush="#232323" BorderThickness="0,0,0,1" x:Name="TitleBar">
      <Grid Margin="16,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="22" Height="22" Background="{StaticResource Accent}" CornerRadius="5" Margin="0,0,10,0">
            <TextBlock Text="F" Foreground="#080808" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="FREESIGNAL" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Border Background="#1E1E1E" CornerRadius="4" Margin="10,0,0,0" Padding="7,3">
            <TextBlock Text="MVP 0.1" FontSize="10" Foreground="#A0A0A0"/>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="MinimizeButton" Style="{StaticResource FlatButton}" Width="40" Height="36" Content="—" FontSize="14"/>
          <Button x:Name="CloseButton" Style="{StaticResource FlatButton}" Width="40" Height="36" Content="×" FontSize="18"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="232"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#0C0C0C" BorderBrush="#232323" BorderThickness="0,0,1,0">
        <Grid Margin="14,18,14,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="УПРАВЛЕНИЕ" Foreground="#656565" FontSize="10" FontWeight="SemiBold" Margin="12,0,0,8"/>
            <Button x:Name="NavHome" Style="{StaticResource NavButton}" Tag="active" Content="01   Главная"/>
            <Button x:Name="NavProfiles" Style="{StaticResource NavButton}" Content="02   Профили"/>
            <Button x:Name="NavDiagnostics" Style="{StaticResource NavButton}" Content="03   Диагностика"/>
            <Button x:Name="NavDomains" Style="{StaticResource NavButton}" Content="04   Домены"/>
            <Button x:Name="NavLogs" Style="{StaticResource NavButton}" Content="05   Журнал"/>
            <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Content="06   Настройки"/>
          </StackPanel>

          <Border Grid.Row="2" Background="#111111" BorderBrush="#262626" BorderThickness="1" CornerRadius="10" Padding="13">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" Fill="#5F5F5F" Margin="0,0,8,0"/>
                <TextBlock x:Name="SidebarStatus" Text="ДВИЖОК ВЫКЛЮЧЕН" FontSize="11" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock x:Name="SidebarVersion" Text="Движок не установлен" Foreground="#777777" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Background="#080808">
        <Grid x:Name="HomePage" Margin="30">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="ГЛАВНАЯ / 01" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/>
              <TextBlock Text="Управление соединением" FontSize="31" FontWeight="SemiBold" Margin="0,7,0,0"/>
              <TextBlock Text="Локальное управление anti-DPI без VPN-аккаунтов и сторонних серверов-посредников." Foreground="#8D8D8D" FontSize="13" Margin="0,8,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="EmergencyStopButton" Style="{StaticResource SecondaryButton}" Foreground="#FF7A7A" Content="АВАРИЙНАЯ ОСТАНОВКА" VerticalAlignment="Top"/>
          </Grid>

          <Border Grid.Row="1" Background="#101010" BorderBrush="#292929" BorderThickness="1" CornerRadius="16" Margin="0,24,0,20" Padding="26">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="ТЕКУЩЕЕ СОСТОЯНИЕ" Foreground="#737373" FontSize="10" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Ellipse x:Name="HeroStatusDot" Width="15" Height="15" Fill="#565656" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <TextBlock x:Name="HeroStatusText" Text="ОТКЛЮЧЕНО" FontSize="25" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock x:Name="HeroStatusDescription" Text="Установите пакет движка, затем выберите профиль или запустите автоматический подбор." Foreground="#939393" FontSize="13" Margin="0,10,40,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                  <Button x:Name="MainToggleButton" Style="{StaticResource PrimaryButton}" Content="ВКЛЮЧИТЬ ДОСТУП" MinWidth="190"/>
                  <Button x:Name="AutoOptimizeButton" Style="{StaticResource SecondaryButton}" Content="ПОДОБРАТЬ АВТОМАТИЧЕСКИ" Margin="10,0,0,0"/>
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Background="#0B0B0B" BorderBrush="#242424" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="АКТИВНЫЙ ПРОФИЛЬ" Foreground="#737373" FontSize="10"/>
                  <TextBlock Grid.Row="1" x:Name="ActiveProfileText" Text="Balanced" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,14"/>
                  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="ДВИЖОК" Foreground="#6F6F6F" FontSize="10"/><TextBlock x:Name="EngineProviderText" Text="Не установлен" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="ЗАЩИТНЫЙ КОНТРОЛЬ" Foreground="#6F6F6F" FontSize="10"/><TextBlock x:Name="WatchdogText" Text="Ожидание" Margin="0,5,0,0"/></StackPanel>
                  </Grid>
                  <Border Grid.Row="3" Background="#141414" CornerRadius="8" Padding="10" Margin="0,16,0,0">
                    <TextBlock Text="Трафик идёт напрямую. FreeSignal не использует прокси и не собирает историю посещений." Foreground="#9A9A9A" FontSize="11" TextWrapping="Wrap"/>
                  </Border>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="СОСТОЯНИЕ СЕРВИСОВ" Foreground="#777777" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,10"/>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Background="#101010" BorderBrush="#262626" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="YOUTUBE" Foreground="#797979" FontSize="10"/><TextBlock x:Name="YouTubeStatus" Text="Не проверено" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock x:Name="YouTubeDetail" Text="Запустите диагностику" Foreground="#777777" FontSize="11"/></StackPanel>
              </Border>
              <Border Grid.Column="1" Background="#101010" BorderBrush="#262626" BorderThickness="1" CornerRadius="12" Padding="18" Margin="8,0">
                <StackPanel><TextBlock Text="DISCORD" Foreground="#797979" FontSize="10"/><TextBlock x:Name="DiscordStatus" Text="Не проверено" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock x:Name="DiscordDetail" Text="Запустите диагностику" Foreground="#777777" FontSize="11"/></StackPanel>
              </Border>
              <Border Grid.Column="2" Background="#101010" BorderBrush="#262626" BorderThickness="1" CornerRadius="12" Padding="18" Margin="8,0,0,0">
                <StackPanel><TextBlock Text="ОБЩИЙ ИНТЕРНЕТ" Foreground="#797979" FontSize="10"/><TextBlock x:Name="InternetStatus" Text="Не проверено" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock x:Name="InternetDetail" Text="Защита готова" Foreground="#777777" FontSize="11"/></StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Grid>

        <Grid x:Name="ProfilesPage" Visibility="Collapsed" Margin="30">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="ПРОФИЛИ / 02" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Выберите режим обработки" FontSize="31" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Начните со сбалансированного режима. Автоподбор проверит безопасные варианты и оставит лучший." Foreground="#8D8D8D" FontSize="13" Margin="0,8,0,0"/></StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,0">
            <StackPanel>
              <Button x:Name="ProfileBalanced" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="СБАЛАНСИРОВАННЫЙ" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Рекомендуемый профиль на каждый день · низкий риск" Foreground="#8B8B8B" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="ВЫБРАТЬ" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/></Grid></Button>
              <Button x:Name="ProfileCompatibility" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="СОВМЕСТИМОСТЬ" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Консервативная альтернатива · низкий риск" Foreground="#8B8B8B" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="ВЫБРАТЬ" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/></Grid></Button>
              <Button x:Name="ProfileAggressive" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="УСИЛЕННЫЙ" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Для сложных конфигураций DPI · средний риск" Foreground="#8B8B8B" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="ВЫБРАТЬ" Foreground="#FFBF69" VerticalAlignment="Center"/></Grid></Button>
              <Button x:Name="ProfileSimple" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ПРОСТОЙ FAKE" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Минимальная стратегия · низкий риск" Foreground="#8B8B8B" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="ВЫБРАТЬ" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/></Grid></Button>
              <Button x:Name="ProfileExperimental" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ЭКСПЕРИМЕНТАЛЬНЫЙ" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Новая стратегия сообщества · высокий риск" Foreground="#8B8B8B" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="ВЫБРАТЬ" Foreground="#FF7A7A" VerticalAlignment="Center"/></Grid></Button>
              <Border Background="#111111" BorderBrush="#282828" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,8,0,0"><TextBlock Text="Профили ссылаются на стратегии установленного пакета. FreeSignal не изменяет исходные файлы скрытно." Foreground="#8C8C8C" TextWrapping="Wrap"/></Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Grid x:Name="DiagnosticsPage" Visibility="Collapsed" Margin="30">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ДИАГНОСТИКА / 03" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Проверьте состояние сети" FontSize="31" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Проверяет целостность движка, права администратора, подпись драйвера, DNS и доступность сервисов." Foreground="#8D8D8D" FontSize="13" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="1" x:Name="RunDiagnosticsButton" Style="{StaticResource PrimaryButton}" Content="ЗАПУСТИТЬ ПОЛНУЮ ПРОВЕРКУ" VerticalAlignment="Top"/></Grid>
          <Border Grid.Row="1" Background="#111111" BorderBrush="#282828" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,22,0,12"><TextBlock x:Name="DiagnosticsSummary" Text="Диагностика ещё не запускалась." Foreground="#AAAAAA"/></Border>
          <ListBox Grid.Row="2" x:Name="DiagnosticsList" Background="#0D0D0D" BorderBrush="#252525" BorderThickness="1" Foreground="#EAEAEA" Padding="8"/>
        </Grid>

        <Grid x:Name="DomainsPage" Visibility="Collapsed" Margin="30">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="ДОМЕНЫ / 04" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Управление областью применения" FontSize="31" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Один домен на строку. Поддомены обрабатываются правилами движка." Foreground="#8D8D8D" FontSize="13" Margin="0,8,0,0"/></StackPanel>
          <Grid Grid.Row="1" Margin="0,22,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="ВКЛЮЧИТЬ" Foreground="#777777" FontSize="10" Margin="2,0,0,8"/><TextBlock Grid.Column="1" Text="ИСКЛЮЧИТЬ" Foreground="#777777" FontSize="10" Margin="14,0,0,8"/>
            <TextBox Grid.Row="1" x:Name="IncludeDomainsText" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ExcludeDomainsText" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" Margin="12,0,0,0"/>
          </Grid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ReloadDomainsButton" Style="{StaticResource SecondaryButton}" Content="ПЕРЕЗАГРУЗИТЬ"/><Button x:Name="SaveDomainsButton" Style="{StaticResource PrimaryButton}" Content="СОХРАНИТЬ СПИСКИ" Margin="10,0,0,0"/></StackPanel>
        </Grid>

        <Grid x:Name="LogsPage" Visibility="Collapsed" Margin="30">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="ЖУРНАЛ / 05" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Прозрачный локальный журнал" FontSize="31" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Журнал содержит только технические события. Посещённые адреса никогда не записываются." Foreground="#8D8D8D" FontSize="13" Margin="0,8,0,0"/></StackPanel>
          <TextBox Grid.Row="1" x:Name="LogsText" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0,22,0,12"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="OpenLogsButton" Style="{StaticResource SecondaryButton}" Content="ОТКРЫТЬ ПАПКУ"/><Button x:Name="RefreshLogsButton" Style="{StaticResource PrimaryButton}" Content="ОБНОВИТЬ" Margin="10,0,0,0"/></StackPanel>
        </Grid>

        <Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="30">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="НАСТРОЙКИ / 06" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Движок и безопасность" FontSize="31" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Телеметрия отсутствует. Движок загружается напрямую из указанного репозитория GitHub." Foreground="#8D8D8D" FontSize="13" Margin="0,8,0,0"/></StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,0"><StackPanel>
            <Border Background="#101010" BorderBrush="#282828" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="ПАКЕТ ДВИЖКА" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="SettingsEngineText" Text="Пакет не установлен" Foreground="#8B8B8B" Margin="0,6,0,14"/><WrapPanel><Button x:Name="InstallEngineButton" Style="{StaticResource PrimaryButton}" Content="УСТАНОВИТЬ / ОБНОВИТЬ"/><Button x:Name="ImportEngineButton" Style="{StaticResource SecondaryButton}" Content="ИМПОРТ ZIP" Margin="10,0,0,0"/><Button x:Name="RemoveEngineButton" Style="{StaticResource SecondaryButton}" Foreground="#FF7A7A" Content="УДАЛИТЬ ДВИЖОК" Margin="10,0,0,0"/></WrapPanel></StackPanel></Border>
            <Border Background="#101010" BorderBrush="#282828" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="АВТОЗАПУСК" FontSize="16" FontWeight="SemiBold"/><CheckBox x:Name="AutoStartCheck" Content="Запускать выбранный профиль после входа в Windows" Margin="0,13,0,0"/><TextBlock Text="Используется видимая задача Планировщика Windows с повышенными правами." Foreground="#777777" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Background="#101010" BorderBrush="#282828" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="ДАННЫЕ И КОНФИДЕНЦИАЛЬНОСТЬ" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Настройки, журнал и движок хранятся в %LOCALAPPDATA%\FreeSignal. История посещений и содержимое пакетов не собираются." Foreground="#8B8B8B" TextWrapping="Wrap" Margin="0,7,0,14"/><WrapPanel><Button x:Name="OpenDataButton" Style="{StaticResource SecondaryButton}" Content="ОТКРЫТЬ ПАПКУ ДАННЫХ"/><Button x:Name="ExportReportButton" Style="{StaticResource SecondaryButton}" Content="ЭКСПОРТ ОТЧЁТА" Margin="10,0,0,0"/></WrapPanel></StackPanel></Border>
            <Border Background="#101010" BorderBrush="#282828" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="ИНТЕРФЕЙС" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Выберите язык интерфейса. Изменение применяется после перезапуска FreeSignal." Foreground="#8B8B8B" TextWrapping="Wrap" Margin="0,7,0,12"/><ComboBox x:Name="LanguageCombo"><ComboBoxItem Content="Automatic / Системный"/><ComboBoxItem Content="Русский"/><ComboBoxItem Content="English"/></ComboBox></StackPanel></Border>
            <Border Background="#101010" BorderBrush="#282828" BorderThickness="1" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="О ПРОГРАММЕ" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="FreeSignal MVP 0.1 · Разработано DUONIQ" Margin="0,8,0,3"/><TextBlock Text="Открытый клиент управления. Использует независимо лицензируемые компоненты экосистемы zapret." Foreground="#777777" TextWrapping="Wrap"/></StackPanel></Border>
          </StackPanel></ScrollViewer>
        </Grid>

        <Border x:Name="BusyOverlay" Background="#D9080808" Visibility="Collapsed" Panel.ZIndex="10">
          <Border Background="#111111" BorderBrush="#303030" BorderThickness="1" CornerRadius="14" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
            <StackPanel><TextBlock x:Name="BusyTitle" Text="Выполняется" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="BusyDescription" Text="Не закрывайте FreeSignal." Foreground="#8D8D8D" Margin="0,8,0,16" TextWrapping="Wrap"/><ProgressBar Height="5" IsIndeterminate="True" Foreground="{StaticResource Accent}" Background="#252525"/></StackPanel>
          </Border>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
