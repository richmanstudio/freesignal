<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeSignal" Width="1220" Height="800" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="#080808" Foreground="#F2F2F2" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#B6FF00"/>
    <SolidColorBrush x:Key="Background" Color="#080808"/>
    <SolidColorBrush x:Key="Panel" Color="#101010"/>
    <SolidColorBrush x:Key="Panel2" Color="#151515"/>
    <SolidColorBrush x:Key="Border" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="Muted" Color="#8D8D8D"/>
    <SolidColorBrush x:Key="Danger" Color="#FF5C5C"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F2F2F2"/>
    </Style>
    <Style TargetType="Button" x:Key="FlatButton">
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="7" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource FlatButton}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="#080808"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,12"/>
    </Style>
    <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource FlatButton}">
      <Setter Property="Background" Value="#191919"/>
      <Setter Property="BorderBrush" Value="#333333"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,11"/>
    </Style>
    <Style TargetType="Button" x:Key="NavButton" BasedOn="{StaticResource FlatButton}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Padding" Value="14,11"/>
      <Style.Triggers>
        <Trigger Property="Tag" Value="active">
          <Setter Property="Background" Value="#1D260E"/>
          <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0D0D0D"/>
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="BorderBrush" Value="#303030"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#151515"/>
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="BorderBrush" Value="#303030"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="MinWidth" Value="190"/>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#0D0D0D" BorderBrush="#232323" BorderThickness="0,0,0,1" x:Name="TitleBar">
      <Grid Margin="16,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="22" Height="22" Background="{StaticResource Accent}" CornerRadius="5" Margin="0,0,10,0">
            <TextBlock Text="F" Foreground="#080808" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="FREESIGNAL" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Border Background="#1E1E1E" CornerRadius="4" Margin="10,0,0,0" Padding="7,3">
            <TextBlock Text="MVP 0.1" FontSize="10" Foreground="#A0A0A0"/>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="MinimizeButton" Style="{StaticResource FlatButton}" Width="40" Height="36" Content="—" FontSize="14"/>
          <Button x:Name="CloseButton" Style="{StaticResource FlatButton}" Width="40" Height="36" Content="×" FontSize="18"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="232"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#0C0C0C" BorderBrush="#232323" BorderThickness="0,0,1,0">
        <Grid Margin="14,18,14,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="CONTROL" Foreground="#656565" FontSize="10" FontWeight="SemiBold" Margin="12,0,0,8"/>
            <Button x:Name="NavHome" Style="{StaticResource NavButton}" Tag="active" Content="01   Overview"/>
            <Button x:Name="NavProfiles" Style="{StaticResource NavButton}" Content="02   Profiles"/>
            <Button x:Name="NavDiagnostics" Style="{StaticResource NavButton}" Content="03   Diagnostics"/>
            <Button x:Name="NavDomains" Style="{StaticResource NavButton}" Content="04   Domains"/>
            <Button x:Name="NavLogs" Style="{StaticResource NavButton}" Content="05   Logs"/>
            <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Content="06   Settings"/>
          </StackPanel>

          <Border Grid.Row="2" Background="#111111" BorderBrush="#262626" BorderThickness="1" CornerRadius="10" Padding="13">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" Fill="#5F5F5F" Margin="0,0,8,0"/>
                <TextBlock x:Name="SidebarStatus" Text="ENGINE OFFLINE" FontSize="11" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock x:Name="SidebarVersion" Text="No engine installed" Foreground="#777777" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Background="#080808">
        <Grid x:Name="HomePage" Margin="30">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="OVERVIEW / 01" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/>
              <TextBlock Text="Connection control" FontSize="31" FontWeight="SemiBold" Margin="0,7,0,0"/>
              <TextBlock Text="Local anti-DPI orchestration without VPN accounts or third-party traffic relays." Foreground="#8D8D8D" FontSize="13" Margin="0,8,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="EmergencyStopButton" Style="{StaticResource SecondaryButton}" Foreground="#FF7A7A" Content="EMERGENCY STOP" VerticalAlignment="Top"/>
          </Grid>

          <Border Grid.Row="1" Background="#101010" BorderBrush="#292929" BorderThickness="1" CornerRadius="16" Margin="0,24,0,20" Padding="26">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="CURRENT STATE" Foreground="#737373" FontSize="10" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Ellipse x:Name="HeroStatusDot" Width="15" Height="15" Fill="#565656" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <TextBlock x:Name="HeroStatusText" Text="DISCONNECTED" FontSize="25" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock x:Name="HeroStatusDescription" Text="Install the engine package, then choose a profile or run automatic optimization." Foreground="#939393" FontSize="13" Margin="0,10,40,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                  <Button x:Name="MainToggleButton" Style="{StaticResource PrimaryButton}" Content="ENABLE CONNECTION" MinWidth="190"/>
                  <Button x:Name="AutoOptimizeButton" Style="{StaticResource SecondaryButton}" Content="AUTO OPTIMIZE" Margin="10,0,0,0"/>
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Background="#0B0B0B" BorderBrush="#242424" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="ACTIVE PROFILE" Foreground="#737373" FontSize="10"/>
                  <TextBlock Grid.Row="1" x:Name="ActiveProfileText" Text="Balanced" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,14"/>
                  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="ENGINE" Foreground="#6F6F6F" FontSize="10"/><TextBlock x:Name="EngineProviderText" Text="Not installed" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="WATCHDOG" Foreground="#6F6F6F" FontSize="10"/><TextBlock x:Name="WatchdogText" Text="Standby" Margin="0,5,0,0"/></StackPanel>
                  </Grid>
                  <Border Grid.Row="3" Background="#141414" CornerRadius="8" Padding="10" Margin="0,16,0,0">
                    <TextBlock Text="Traffic stays direct. FreeSignal does not operate a proxy or collect browsing history." Foreground="#9A9A9A" FontSize="11" TextWrapping="Wrap"/>
                  </Border>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="SERVICE HEALTH" Foreground="#777777" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,10"/>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Background="#101010" BorderBrush="#262626" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="YOUTUBE" Foreground="#797979" FontSize="10"/><TextBlock x:Name="YouTubeStatus" Text="Not checked" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock x:Name="YouTubeDetail" Text="Run diagnostics" Foreground="#777777" FontSize="11"/></StackPanel>
              </Border>
              <Border Grid.Column="1" Background="#101010" BorderBrush="#262626" BorderThickness="1" CornerRadius="12" Padding="18" Margin="8,0">
                <StackPanel><TextBlock Text="DISCORD" Foreground="#797979" FontSize="10"/><TextBlock x:Name="DiscordStatus" Text="Not checked" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock x:Name="DiscordDetail" Text="Run diagnostics" Foreground="#777777" FontSize="11"/></StackPanel>
              </Border>
              <Border Grid.Column="2" Background="#101010" BorderBrush="#262626" BorderThickness="1" CornerRadius="12" Padding="18" Margin="8,0,0,0">
                <StackPanel><TextBlock Text="GENERAL INTERNET" Foreground="#797979" FontSize="10"/><TextBlock x:Name="InternetStatus" Text="Not checked" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock x:Name="InternetDetail" Text="Watchdog ready" Foreground="#777777" FontSize="11"/></StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Grid>

        <Grid x:Name="ProfilesPage" Visibility="Collapsed" Margin="30">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="PROFILES / 02" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Choose how traffic is handled" FontSize="31" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Start with Balanced. Automatic mode benchmarks the safe candidates and keeps the best result." Foreground="#8D8D8D" FontSize="13" Margin="0,8,0,0"/></StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,0">
            <StackPanel>
              <Button x:Name="ProfileBalanced" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="BALANCED" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Recommended daily profile · low risk" Foreground="#8B8B8B" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="SELECT" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/></Grid></Button>
              <Button x:Name="ProfileCompatibility" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="COMPATIBILITY" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Conservative alternative · low risk" Foreground="#8B8B8B" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="SELECT" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/></Grid></Button>
              <Button x:Name="ProfileAggressive" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="AGGRESSIVE" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="For difficult DPI configurations · medium risk" Foreground="#8B8B8B" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="SELECT" Foreground="#FFBF69" VerticalAlignment="Center"/></Grid></Button>
              <Button x:Name="ProfileSimple" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SIMPLE FAKE" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Minimal strategy · low risk" Foreground="#8B8B8B" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="SELECT" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/></Grid></Button>
              <Button x:Name="ProfileExperimental" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="EXPERIMENTAL" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Newest community strategy · high risk" Foreground="#8B8B8B" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="SELECT" Foreground="#FF7A7A" VerticalAlignment="Center"/></Grid></Button>
              <Border Background="#111111" BorderBrush="#282828" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,8,0,0"><TextBlock Text="Profiles are references to strategy files from the installed engine package. FreeSignal does not silently modify those files." Foreground="#8C8C8C" TextWrapping="Wrap"/></Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Grid x:Name="DiagnosticsPage" Visibility="Collapsed" Margin="30">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DIAGNOSTICS / 03" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Understand the network state" FontSize="31" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Checks engine integrity, administrator access, driver signature, DNS and service endpoints." Foreground="#8D8D8D" FontSize="13" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="1" x:Name="RunDiagnosticsButton" Style="{StaticResource PrimaryButton}" Content="RUN FULL CHECK" VerticalAlignment="Top"/></Grid>
          <Border Grid.Row="1" Background="#111111" BorderBrush="#282828" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,22,0,12"><TextBlock x:Name="DiagnosticsSummary" Text="No diagnostic session yet." Foreground="#AAAAAA"/></Border>
          <ListBox Grid.Row="2" x:Name="DiagnosticsList" Background="#0D0D0D" BorderBrush="#252525" BorderThickness="1" Foreground="#EAEAEA" Padding="8"/>
        </Grid>

        <Grid x:Name="DomainsPage" Visibility="Collapsed" Margin="30">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="DOMAINS / 04" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Control the target scope" FontSize="31" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="One domain per line. Subdomains are handled by the engine package rules." Foreground="#8D8D8D" FontSize="13" Margin="0,8,0,0"/></StackPanel>
          <Grid Grid.Row="1" Margin="0,22,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="INCLUDE" Foreground="#777777" FontSize="10" Margin="2,0,0,8"/><TextBlock Grid.Column="1" Text="EXCLUDE" Foreground="#777777" FontSize="10" Margin="14,0,0,8"/>
            <TextBox Grid.Row="1" x:Name="IncludeDomainsText" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ExcludeDomainsText" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" Margin="12,0,0,0"/>
          </Grid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ReloadDomainsButton" Style="{StaticResource SecondaryButton}" Content="RELOAD"/><Button x:Name="SaveDomainsButton" Style="{StaticResource PrimaryButton}" Content="SAVE LISTS" Margin="10,0,0,0"/></StackPanel>
        </Grid>

        <Grid x:Name="LogsPage" Visibility="Collapsed" Margin="30">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="LOGS / 05" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Transparent local activity" FontSize="31" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Logs contain operational events only. URLs visited by the user are never recorded." Foreground="#8D8D8D" FontSize="13" Margin="0,8,0,0"/></StackPanel>
          <TextBox Grid.Row="1" x:Name="LogsText" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0,22,0,12"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="OpenLogsButton" Style="{StaticResource SecondaryButton}" Content="OPEN FOLDER"/><Button x:Name="RefreshLogsButton" Style="{StaticResource PrimaryButton}" Content="REFRESH" Margin="10,0,0,0"/></StackPanel>
        </Grid>

        <Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="30">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="SETTINGS / 06" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Engine and safety settings" FontSize="31" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="No telemetry is enabled. Engine downloads come directly from the configured GitHub repository." Foreground="#8D8D8D" FontSize="13" Margin="0,8,0,0"/></StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,0"><StackPanel>
            <Border Background="#101010" BorderBrush="#282828" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="ENGINE PACKAGE" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="SettingsEngineText" Text="No package installed" Foreground="#8B8B8B" Margin="0,6,0,14"/><WrapPanel><Button x:Name="InstallEngineButton" Style="{StaticResource PrimaryButton}" Content="INSTALL / UPDATE"/><Button x:Name="ImportEngineButton" Style="{StaticResource SecondaryButton}" Content="IMPORT ZIP" Margin="10,0,0,0"/><Button x:Name="RemoveEngineButton" Style="{StaticResource SecondaryButton}" Foreground="#FF7A7A" Content="REMOVE ENGINE" Margin="10,0,0,0"/></WrapPanel></StackPanel></Border>
            <Border Background="#101010" BorderBrush="#282828" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="STARTUP" FontSize="16" FontWeight="SemiBold"/><CheckBox x:Name="AutoStartCheck" Content="Start the selected profile when I sign in" Margin="0,13,0,0"/><TextBlock Text="Implemented with a visible Windows scheduled task running at the highest privilege level." Foreground="#777777" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Background="#101010" BorderBrush="#282828" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="DATA &amp; PRIVACY" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Configuration, logs and engine files stay under %LOCALAPPDATA%\FreeSignal. No browsing history or packet payloads are collected by this client." Foreground="#8B8B8B" TextWrapping="Wrap" Margin="0,7,0,14"/><WrapPanel><Button x:Name="OpenDataButton" Style="{StaticResource SecondaryButton}" Content="OPEN DATA FOLDER"/><Button x:Name="ExportReportButton" Style="{StaticResource SecondaryButton}" Content="EXPORT SUPPORT REPORT" Margin="10,0,0,0"/></WrapPanel></StackPanel></Border>
            <Border Background="#101010" BorderBrush="#282828" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="INTERFACE" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Choose the interface language. The change is applied after restarting FreeSignal." Foreground="#8B8B8B" TextWrapping="Wrap" Margin="0,7,0,12"/><ComboBox x:Name="LanguageCombo"><ComboBoxItem Content="Automatic / Системный"/><ComboBoxItem Content="Русский"/><ComboBoxItem Content="English"/></ComboBox></StackPanel></Border>
            <Border Background="#101010" BorderBrush="#282828" BorderThickness="1" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="ABOUT" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="FreeSignal MVP 0.1 · Built by DUONIQ" Margin="0,8,0,3"/><TextBlock Text="Open-source orchestration client. Powered by independently licensed zapret ecosystem components." Foreground="#777777" TextWrapping="Wrap"/></StackPanel></Border>
          </StackPanel></ScrollViewer>
        </Grid>

        <Border x:Name="BusyOverlay" Background="#D9080808" Visibility="Collapsed" Panel.ZIndex="10">
          <Border Background="#111111" BorderBrush="#303030" BorderThickness="1" CornerRadius="14" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
            <StackPanel><TextBlock x:Name="BusyTitle" Text="Working" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="BusyDescription" Text="Please keep FreeSignal open." Foreground="#8D8D8D" Margin="0,8,0,16" TextWrapping="Wrap"/><ProgressBar Height="5" IsIndeterminate="True" Foreground="{StaticResource Accent}" Background="#252525"/></StackPanel>
          </Border>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
